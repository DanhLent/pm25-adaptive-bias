#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT="$HOME/Documents/pm_25_pj"
STATE="$PROJECT/data/live/state"
LOCK="$STATE/pm25_unified_pipeline.lock"

SERVICE="pm25-unified.service"
TIMER="pm25-unified.timer"
BACKUP_TIMER="pm25-cloud-backup.timer"

usage() {
    cat <<'EOF'
Usage:
  pm25ctl status     Check timers, service, lock and data freshness
  pm25ctl recover    Safely recover from a stale pipeline lock
  pm25ctl run        Run one unified pipeline cycle now
  pm25ctl logs       Show recent unified pipeline logs
  pm25ctl timers     Show PM2.5 timers
EOF
}

lock_pid() {
    python3 - "$LOCK" <<'PY'
import json
import sys
from pathlib import Path

p = Path(sys.argv[1])

if not p.exists():
    raise SystemExit(0)

try:
    obj = json.loads(p.read_text())
    pid = obj.get("pid")
    if isinstance(pid, int):
        print(pid)
except Exception:
    pass
PY
}

show_lock() {
    echo "=== LOCK ==="

    if [ ! -f "$LOCK" ]; then
        echo "OK: no pipeline lock"
        return
    fi

    cat "$LOCK"
    echo

    PID="$(lock_pid || true)"

    if [ -z "$PID" ]; then
        echo "WARN: lock exists but PID could not be parsed"
        return
    fi

    if kill -0 "$PID" 2>/dev/null; then
        echo "ACTIVE: PID $PID is alive"
        ps -fp "$PID" || true
    else
        echo "STALE: PID $PID is no longer running"
    fi
}

show_data() {
    echo "=== DATA FRESHNESS ==="

    python3 - "$PROJECT" <<'PY'
import csv
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

root = Path(sys.argv[1])

files = [
    ("PurpleAir 10min", root / "data/interim/purpleair_10min_qc.csv",
     ("timestamp", "time"), 45),
    ("PurpleAir hourly", root / "data/interim/purpleair_hourly.csv",
     ("time", "timestamp"), 120),
    ("CAMS", root / "data/interim/cams_all_available.csv",
     ("time", "timestamp"), None),
]

now = datetime.now(timezone.utc)

def parse_time(value):
    if not value:
        return None

    value = value.strip()

    try:
        if value.endswith("Z"):
            value = value[:-1] + "+00:00"

        dt = datetime.fromisoformat(value)

        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)

        return dt.astimezone(timezone.utc)
    except Exception:
        return None

for label, path, columns, threshold in files:
    print(f"\n{label}:")

    if not path.exists():
        print("  MISSING")
        continue

    newest = None

    try:
        with path.open(newline="", encoding="utf-8") as f:
            reader = csv.DictReader(f)

            for row in reader:
                for col in columns:
                    dt = parse_time(row.get(col))

                    if dt is not None and (newest is None or dt > newest):
                        newest = dt
                        break
    except Exception as e:
        print(f"  ERROR reading CSV: {e}")
        continue

    mtime = datetime.fromtimestamp(path.stat().st_mtime, timezone.utc)
    mtime_age = (now - mtime).total_seconds() / 60

    print(f"  file updated : {mtime.astimezone().isoformat(timespec='seconds')}")
    print(f"  mtime age    : {mtime_age:.1f} min")

    if newest is not None:
        local = newest.astimezone()
        age = (now - newest).total_seconds() / 60

        print(f"  latest data  : {local.isoformat(timespec='seconds')}")
        print(f"  data age     : {age:.1f} min")

        if threshold is not None:
            if age <= threshold:
                state = "OK"
            elif age <= threshold * 2:
                state = "WARN"
            else:
                state = "STALE"

            print(f"  state        : {state}")
    else:
        print("  latest data  : unknown")

    if label == "CAMS":
        print("  note         : CAMS may contain future forecast timestamps")
PY
}

status_cmd() {
    echo "================ PM2.5 STATUS ================"

    echo
    echo "=== TIME ==="
    date
    date -u

    echo
    echo "=== TIMERS ==="
    systemctl --user is-active "$TIMER" || true
    systemctl --user is-active "$BACKUP_TIMER" || true

    systemctl --user list-timers --all \
        | grep -E 'pm25-(unified|cloud)' || true

    echo
    echo "=== LAST SERVICE RESULT ==="

    systemctl --user show "$SERVICE" \
        -p ActiveState \
        -p SubState \
        -p Result \
        -p ExecMainStatus \
        --no-pager

    echo
    show_lock

    echo
    show_data

    echo
    echo "==============================================="
}

recover_cmd() {
    echo "=== PM2.5 SAFE RECOVERY ==="

    mkdir -p "$STATE/stale-locks"

    if [ -f "$LOCK" ]; then
        PID="$(lock_pid || true)"

        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            echo "ERROR: lock owner PID $PID is still alive."
            ps -fp "$PID" || true
            echo
            echo "Recovery aborted. Nothing was removed."
            exit 1
        fi

        STAMP="$(date +%Y%m%d_%H%M%S)"
        DEST="$STATE/stale-locks/pm25_unified_pipeline.lock.$STAMP"

        mv -- "$LOCK" "$DEST"

        echo "Archived stale lock:"
        echo "  $DEST"
    else
        echo "No stale lock found."
    fi

    echo
    echo "Resetting failed service state..."

    systemctl --user reset-failed "$SERVICE" || true

    echo
    echo "Ensuring timers are running..."

    systemctl --user start "$TIMER"
    systemctl --user start "$BACKUP_TIMER"

    echo
    echo "Running one pipeline cycle..."

    systemctl --user start "$SERVICE"

    echo
    echo "Pipeline run completed."

    echo
    systemctl --user show "$SERVICE" \
        -p Result \
        -p ExecMainStatus \
        --no-pager

    echo
    show_data
}

run_cmd() {
    if [ -f "$LOCK" ]; then
        PID="$(lock_pid || true)"

        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            echo "Pipeline is already running as PID $PID."
            exit 0
        fi

        echo "ERROR: stale lock detected."
        echo "Run:"
        echo "  pm25ctl recover"
        exit 1
    fi

    systemctl --user start "$SERVICE"

    systemctl --user show "$SERVICE" \
        -p Result \
        -p ExecMainStatus \
        --no-pager

    show_data
}

logs_cmd() {
    journalctl --user \
        -u "$SERVICE" \
        -n 80 \
        --no-pager
}

timers_cmd() {
    systemctl --user list-timers --all \
        | grep -E 'pm25-(unified|cloud)' || true
}

case "${1:-status}" in
    status)
        status_cmd
        ;;
    recover)
        recover_cmd
        ;;
    run)
        run_cmd
        ;;
    logs)
        logs_cmd
        ;;
    timers)
        timers_cmd
        ;;
    *)
        usage
        exit 2
        ;;
esac
